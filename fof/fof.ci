module fof {
  // Friends-of-Friends application module, extracted from the paratreet core
  // module (2026-08; see design/fof-module.md). The core toolkit carries no
  // FoF code: this module consumes the core's generic hooks (TreePiece::
  // callPerTreePieceFn, upwardPass, the visitor/traverser interface) from the
  // outside. Chares are templated over the app Data type; applications
  // instantiate them via extern entry declarations in their mainmodule
  // (see examples/fof3/Main.ci).
  extern module paratreet;

  // Distributed union-find for FoF step 4 (sibling UIUC-PPL/unionfind; see
  // design/step4.md). Living here — not in the core module — makes linking
  // unionfind/prefix/htram an FoF-only cost; non-FoF applications build
  // without the siblings entirely.
  extern module unionFindLib;

  // Keep-alive ring for the LCI idle-stall workaround (see FoF.C and
  // WORKAROUND-lci-idle-stall.md): registered per PE, armed on one PE
  // per process; raw Converse messages, invisible to quiescence
  // detection by construction.
  initproc void fofKeepAliveInit(void);

  // FoF phase 1 (see fof/FoFPhase1.h and design/phase1.md).
  // Per-process side: TreePiece registry for phaseB pair enumeration, boundary
  // edge collection, and the PE-tip -> process-level tip merge map.
  template <typename Data>
  nodegroup FoFPhase1Node {
    entry FoFPhase1Node();
    entry void reset(const CkCallback&);
    entry void fragmentHistogram(const CkCallback&);
    entry void redundancyHistogram(const CkCallback&);
    // Step 4 (distributed UF_2, -u dist): builds the owner-encoded tip
    // namespace (node << 40 | dense_index) from frag_counts (already
    // populated by countFragments) and the UF_2 vertex array to hand to
    // UnionFindLib. See fof/FoFPhase1.h "Tip encoding" and design/step4.md.
    // Must run after countFragments, before applyTipEncoding.
    entry void computeTipEncoding(const CkCallback&);
    // Stage 3 of design/relabel-representative.md: receive this process's
    // slice of the phase-3 label map (keys owner-sharded by processor 0),
    // store it once per process, and trigger applySliceOnPE on each of the
    // process's FoFPhase1 elements. The group is identified by CkGroupID
    // (a plain type — the templated CProxy_FoFPhase1 is not yet declared
    // at this point in the module).
    entry void applyGlobalMapSlice(const std::vector<std::pair<long, long> >&,
                                   const CkGroupID&, const CkCallback&);
    // Responsiveness + transfer probe (campaign P0, FOF_PROBE=1;
    // design/phaseab-balancing.md section 14).
    entry void probeStart(const CkCallback&);
    entry void probeReport(const CkCallback&);
    entry void probePing(int from, double t0);
    entry void probeAck(int target, double t0);
    entry void probeXfer(int from, double t0, const std::vector<char>&);
    entry void probeXferAck(double t0, long bytes);
  };

  // Per-PE side: per-PE union-find (phaseA), cross-PE edge emission
  // (phaseB), relabel through the merge map, per-tip fragment counting
  // (countFragments), and a collect helper for validation.
  // The phase-3 entries (see fof/FoFPhase3.h and design/phase3.md) manage the
  // cross-PROCESS edge buffer filled by FoFEdgeVisitor during the boundary
  // walk, gather it to the driver (reduction), and apply the global
  // tip -> root map computed by the serial UF_2 on PE 0.
  template <typename Data>
  group FoFPhase1 {
    entry FoFPhase1(CProxy_FoFPhase1Node<Data>);
    entry void reset(const CkCallback&);
    // Periodic boundary conditions (design/pbc.md): broadcast the box period
    // (0 per axis = open, the default = exact current behavior) before phaseA.
    entry void setPeriod(Vector3D<Real> period, const CkCallback&);
    entry void startPhase1Chain(double b2, double grid_thresh, const CkCallback&);
    // GPU staging chain (design/phase1-gpu.md stage 0). Declared
    // unconditionally — the .ci has no preprocessor — but the bodies are
    // #ifdef FOF_GPU in FoFPhase1.h and are stubs in a CPU-only build, so
    // the generated code is identical in shape and the entries are simply
    // never invoked (paratreet::runFoFPhase1 gates on FOF_GPU_STAGE0).
    entry void deviceStage0(double b2, const CkCallback&);
    entry void deviceInitOnHome();
    entry void devicePack();
    entry void deviceLaunchOnHome();
    entry void deviceCompleteOnHome();
    entry void deviceVerify();
    entry void phaseBChained();
    entry void buildPoolSlice();
    // Campaign S2b: mid-phase relabel/re-annotate between the B1 and B2
    // rounds (FOF_PB_MERGE=1).
    entry void phaseBMidRelabel();
    entry void relabelChained(double tA, double tB, double tM);
    entry void countFragments(const CkCallback&);
    entry void collect(const CkCallback&);
    entry void resetPhase3(const CkCallback&);
    entry void flushPhase3Edges(const CkCallback&);
    entry void phase3Stats(const CkCallback&);
    entry void depositNodeRedundant(const CkCallback&);
    entry void applyGlobalMap(const std::vector<std::pair<long, long> >&, const CkCallback&);
    // Stage-3 sliced counterpart: apply the node branch's stored slice at
    // representative granularity and contribute to the global reduction.
    entry void applySliceOnPE(const CkCallback&);
    // Cluster-assessment entries (see the "Testing on a cluster" section of
    // the top-level README): distributed tip-sentinel check, per-PE memory
    // reduction, and the distributed component-histogram gather used by the
    // fof3 harness's stats mode (no full particle gather).
    entry void verifyTips(long n_total, const CkCallback&);
    entry void memoryStats(const CkCallback&);
    entry void depositLabelCounts(const CkCallback&);
    entry void histogramShard(int min_component_size, const CkCallback&);
    entry void collectTouchedCounts(const CkCallback&);
    // Distributed UF_2 (step 4; encoded tips required — see design/step4.md).
    // applyTipEncoding: owner-writes rewrite of this PE's particles' tips
    // through the node's encode map (built by FoFPhase1Node::computeTipEncoding).
    entry void applyTipEncoding(const CkCallback&);
    // initUF2: wire the process-local UnionFindLib element (vertex array
    // handoff + getLocationFromID registration). Real work happens only on
    // the node's home PE (CkNodeFirst); other PEs of the process no-op.
    entry void initUF2(CProxy_UnionFindLib, const CkCallback&);
    // enableUF2Streaming: arm mid-walk edge-batch submission to UF_2
    // (design/walk-uf2-overlap.md step 1); batch = edges per submission.
    entry void enableUF2Streaming(CProxy_UnionFindLib, long batch,
                                  const CkCallback&);
    // fireUF2Edges: submit this PE's buffered phase-3 edges (already
    // encoded-tip pairs) as batched union_request calls.
    entry void fireUF2Edges(CProxy_UnionFindLib, const CkCallback&);
    // verifyEncodedTips: CkEnforce that every registered particle's tip
    // decodes (node bits, dense-index bounds) to this process's own UF_2
    // vertex array -- the owner-locality invariant the whole scheme depends on.
    entry void verifyEncodedTips(const CkCallback&);
    // applyUF2Labels: owner-writes rewrite from encoded tip to the UF_2
    // library's componentNumber (read back from the node's vertex array,
    // which UnionFindLib::find_components mutated in place).
    entry void collectUF2Labels(CProxy_UnionFindLib, const CkCallback&);
    entry void applyUF2Labels(const CkCallback&);
  };
};
