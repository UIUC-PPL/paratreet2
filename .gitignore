*.o
*.a
*.decl.h
*.def.h
charmrun
# Charm++ trace output (PROJECTIONS=1 / SUMMARY=1 builds) and the stamp
# recording which tracemode is currently linked in. `make cleanp` removes
# the logs.
*.sts
*.projrc
*.[0-9]*.log
*.[0-9]*.log.gz
*.[0-9]*.sum
*.[0-9]*.sumd
.tracemode
.DS_Store
__.SYMDEF
# Example binaries. Patterns are anchored to full paths: bare names like
# "FoF1" would match the examples/fof1 DIRECTORY on case-insensitive
# filesystems (core.ignorecase), silently untracking the whole harness.
examples/searchAlgos/VisitAll
examples/annotate/Annotate
examples/fof1/FoF1
examples/fof3/FoF3
examples/gravity/Gravity
# Input generators (built binaries) and generated datasets. Raw .dat files
# are intermediates; tipsy files >= 100 MB (1M+ particles) must never be
# committed (small ones like 100k ~3.6 MB may be).
inputgen/plummer
inputgen/tipsyPlummer
inputgen/tipsy2nchilada
inputgen/uniform
inputs/*.dat
inputs/1m*.tipsy
inputs/8m*.tipsy
inputs/16m*.tipsy

# GPU stage-0 gate build products (design/phase1-gpu.md section 11)
fof/gpu/*.o
fof/gpu/*.a
fof/gpu/fof-device-test
fof/gpu/stage0.*.out
fof/gpu/stage0.*.err
tests/kokkos-spike/kokkos-spike
tests/nchilada/nchilada-test
tests/nchilada/nchilada-fixture/
