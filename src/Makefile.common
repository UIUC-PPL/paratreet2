# Common path/flag definitions for the ParaTreeT core library and examples.
# BASE_PATH is derived from the location of this file (src/Makefile.common),
# so the tree can live anywhere.
BASE_PATH := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
PARATREET_PATH = $(BASE_PATH)/src
STRUCTURE_PATH = $(BASE_PATH)/utility/structures

INCLUDES:=$(INCLUDES) -I$(STRUCTURE_PATH) -I$(PARATREET_PATH) -I.

CHARM_HOME ?= $(HOME)/charm_reconverse

LD_LIBS:=$(LD_LIBS) -L$(PARATREET_PATH) -lparatreet

# ---- Charm++ tracing (Projections / summary) ----
# OFF by default. Tracing must be LINKED IN: charmc pulls in
# lib/libtrace-<mode>.a and the (always-compiled) trace hooks in the runtime
# and in generated .def.h code stop being no-ops. Enable per build:
#   make PROJECTIONS=1   # -tracemode projections: full event log
#   make SUMMARY=1       # -tracemode summary: compact per-PE utilization
# Both may be set at once (charmc accepts repeated -tracemode). Because this
# is link-only, toggling it does NOT require rebuilding libparatreet.a or
# libfof.a — only the application relink. Passing an empty value
# (PROJECTIONS=) is off, matching the AGGREGATION convention above.
# See the README ("Tracing with Projections") for output files and the
# runtime +trace* flags.
# The test is on the VALUE, not on whether the variable is defined:
# `make PROJECTIONS=0` has to mean off. It used to mean ON (the test was
# "non-empty"), which stays invisible for as long as nobody passes 0 — and
# then fof/gpu/rebuild_deps.sh started passing PROJECTIONS=0 as its
# default and every build silently linked tracing in.
TRACE_MODES :=
ifneq ($(filter-out 0 no off false,$(strip $(PROJECTIONS))),)
	TRACE_MODES += projections
endif
ifneq ($(filter-out 0 no off false,$(strip $(SUMMARY))),)
	TRACE_MODES += summary
endif
TRACE_FLAGS := $(foreach m,$(TRACE_MODES),-tracemode $(m))

# -tracemode changes ONLY the link line, so none of an application's
# prerequisites (objects, libraries) change when it is toggled: a bare
# `make PROJECTIONS=1` over an existing build would report "up to date" and
# leave an untraced binary in place. Each application therefore lists
# $(TRACE_STAMP) among its link prerequisites. The stamp records the mode
# currently linked in and is only rewritten — i.e. its mtime only moves —
# when the requested mode differs, so an unchanged setting never relinks.
# Both target names start with '.', which keeps them out of the running for
# make's default goal, so this rule is safe to define in an included file.
TRACE_STAMP = .tracemode
.PHONY: .FORCE
.FORCE:
$(TRACE_STAMP): .FORCE
	@echo '$(TRACE_FLAGS)' | cmp -s - $@ || echo '$(TRACE_FLAGS)' > $@

# Trace output written into the run directory: projections logs
# (<prog>.<pe>.log[.gz], <prog>.sts, <prog>.projrc) and summary logs
# (<prog>.<pe>.sum, <prog>.<pe>.sumd, <prog>.sum.sts). Removed by `make
# cleanp`, which every example defines; kept out of `clean` so a rebuild
# never silently discards collected traces.
# The per-PE patterns are deliberately narrow (<prog>.<pe>.log, never a bare
# *.log) so an unrelated run log sitting in the same directory survives.
TRACE_OUTPUTS = *.sts *.projrc *.[0-9]*.log *.[0-9]*.log.gz *.[0-9]*.sum *.[0-9]*.sumd

# ---- FoF module (fof/) and its sibling libraries ----
# Only FoF applications (examples/fof1, examples/fof3) need any of this: the
# fof module extern-references unionFindLib, so unionfind/prefix/htram are an
# FoF-only link. Non-FoF applications build without the siblings entirely.
FOF_PATH = $(BASE_PATH)/fof
UNION_FIND_DIR = $(BASE_PATH)/../unionfind
HTRAM_DIR = $(BASE_PATH)/../htram
PREFIX_LIB_DIR = $(UNION_FIND_DIR)/prefixLib

# htram aggregation for the unionfind sibling. MUST MATCH how ../unionfind was
# built: unionFindLib.h changes class layout under this flag, so a mismatch is
# an ABI break.
# -DUNIONFIND rides along because AGGREGATION makes unionFindLib.h include
# htram_group.h, whose datatype selection needs that macro in every client TU
# (harmlessly duplicated where OPTS already define it).
# DEFAULT OFF since 2026-07-27 (interleaved 80M/480-PE measurement: htram
# cost 1-2.4 s of uf2 at 22k edges; see design/phase1-scaling.md "Final
# round"). -DUNIONFIND stays: it selects the htram datatype and is
# independent of whether aggregation is used. To build WITH aggregation
# (multi-billion-particle insurance), use — in fof/ and the FoF examples AND
# in the sibling unionfind (make AGGREGATION=-DAGGREGATION there), plus make
# clean everywhere in between:
#   make AGGREGATION="-DAGGREGATION -DUNIONFIND"
AGGREGATION ?= -DUNIONFIND

# ---- GPU arm (design/phase1-gpu.md). OFF by default: with GPU unset the
# compile and link lines are byte-identical to the CPU build.
#   make GPU=1        in fof/ and the FoF examples (and build fof/gpu first)
# Requires a HIP-enabled charm (CHARM_HOME=.../reconverse-linux-x86_64-amd);
# -D__HIP_PLATFORM_AMD__ is what makes hapi.h's hipStream_t prototypes
# declare under g++ (design/phase1-gpu.md section 11.3 trap 4).
KOKKOS_DIR ?= /ccs/home/rrao/kokkos
FOF_GPU_PATH = $(FOF_PATH)/gpu

# A HIP-ENABLED charm makes charm++.h pull in <hip/hip_runtime.h>
# (charm++.h -> ckrdmadevice.h -> conv-rdmadevice.h -> hapi_portable.h),
# and the HIP headers hard-#error unless the platform macro is set. So
# EVERY translation unit built against such a charm needs it, GPU code or
# not — this is a property of the charm build, not of the GPU arm, which
# is why it is detected here rather than tied to GPU=1.
HAS_HAPI := $(wildcard $(CHARM_HOME)/include/hapi.h)
ifneq ($(HAS_HAPI),)
	INCLUDES := $(INCLUDES) -D__HIP_PLATFORM_AMD__
endif
ifeq ($(GPU),1)
	GPU_OPTS = -DFOF_GPU -I$(FOF_PATH)
	FOF_GPU_LD_LIBS = -L$(FOF_GPU_PATH) -lfofdevice \
	                  -L$(KOKKOS_DIR)/lib64 -lkokkoscontainers \
	                  -lkokkosalgorithms -lkokkoscore -ldl
	# Name the archive as a LINK PREREQUISITE, not just as -l: without it
	# `make` reports the application up to date after the device library
	# is rebuilt and silently relinks nothing (the stale-.a trap
	# design/frontier-labeling-ab.md records for libunionFind.a — it cost
	# a wasted job here on 2026-08-12).
	FOF_GPU_LIB = $(FOF_GPU_PATH)/libfofdevice.a
else
	GPU_OPTS =
	FOF_GPU_LD_LIBS =
	FOF_GPU_LIB =
endif

FOF_INCLUDES = -I$(FOF_PATH) -I$(PREFIX_LIB_DIR) -I$(UNION_FIND_DIR) -I$(HTRAM_DIR) $(AGGREGATION)
FOF_LD_LIBS = -L$(FOF_PATH) -lfof -L$(UNION_FIND_DIR) -lunionFind -L${PREFIX_LIB_DIR} -lprefix -L${HTRAM_DIR} -lhtram_group_unionfind

# XDR library for Tipsy file I/O
# First check for system RPC XDR library, then fall back to utility/xdr
HAS_SYSTEM_XDR := $(shell printf '\043include <rpc/xdr.h>\n' | $(CC) -E - >/dev/null 2>&1 && echo yes)
ifeq ($(HAS_SYSTEM_XDR),yes)
	# Use system RPC XDR library
	# Try different library names depending on the system.
	# NOTE: link a real main() here, not /dev/null — an empty translation
	# unit has no main symbol, and strict linkers (e.g. lld, as used by the
	# Cray cc wrapper) fail such a link with "undefined symbol: main"
	# regardless of whether the requested library resolves, producing a
	# false "not found" for libraries that actually work.
	HAS_LIBRPC := $(shell echo 'int main(){return 0;}' | $(CC) -xc - -lrpc -o /dev/null >/dev/null 2>&1 && echo yes)
	HAS_LIBTIRPC := $(shell echo 'int main(){return 0;}' | $(CC) -xc - -ltirpc -o /dev/null >/dev/null 2>&1 && echo yes)
	ifeq ($(HAS_LIBRPC),yes)
		LD_LIBS:=$(LD_LIBS) -lrpc
	else ifeq ($(HAS_LIBTIRPC),yes)
		LD_LIBS:=$(LD_LIBS) -ltirpc
	endif
	# If neither library is needed, XDR functions are in libc (older glibc)
else
	# Fall back to utility/xdr library
	XDR_PATH=$(BASE_PATH)/utility/xdr
	ifneq (,$(wildcard $(XDR_PATH)/libxdr.a))
		INCLUDES:=$(INCLUDES) -I$(BASE_PATH)/utility/xdr
		LD_LIBS:=$(LD_LIBS) -L$(XDR_PATH) -lxdr
	endif
endif

# TIRPC is required on Summit
TIRPC_PATH?=/usr/include/tirpc
ifneq (,$(wildcard $(TIRPC_PATH)))
	INCLUDES:=$(INCLUDES) -I$(TIRPC_PATH)
	LD_LIBS:=$(LD_LIBS) -ltirpc
endif
