 #include "ck.h"
 
+// ---------------------------------------------------------------------------
+// PROJECTIONS INSTRUMENTATION FOR THE QD PROTOCOL.  Research instrument added
+// 2026-08-20; see ~/software/reports/relay37.txt.
+//
+// QdMsg travels as a raw Converse message dispatched by CmiHandleMessage, and
+// neither charm nor reconverse puts a trace hook there.  So Projections shows
+// the waitQD() that posts a detection and the onQD() that ends it, and NOTHING
+// in between -- on Frontier at 896 PEs that gap is 53-81 ms with the machine
+// otherwise completely idle, six times per run.  These user events make each
+// leg, each round and each idle wait a first-class Projections record.
+//
+// TRACE_QD_IDLEWAIT is the one that matters most: it brackets the interval
+// from the QD message landing on a PE to the CcdPROCESSOR_STILL_IDLE
+// condition actually firing, so its LENGTH is the per-hop idle wait.  Summed
+// over a round it should account for the ~21 ms per round we measured
+// indirectly from idle-exit waves.
+//
+// Cost when tracing is off: traceUserEvent and friends are no-ops in a
+// non-traced build, and one predictable branch per QD message otherwise.  QD
+// messages number a few tens of thousands per run, so this is free.
+// ---------------------------------------------------------------------------
+#define TRACE_QD_IDLEWAIT  9100
+#define TRACE_QD_PHASE0    9101
+#define TRACE_QD_PHASE1    9102
+#define TRACE_QD_PHASE2    9103
+#define TRACE_QD_ROUND     9104
+#define TRACE_QD_DETECTED  9105
+#define TRACE_QD_START     9106
+
+// Registered lazily, per PE, so this cannot depend on where initQd sits in the
+// startup order relative to trace initialisation.  PE 0 always runs CkStartQD,
+// so PE 0's table -- the one written to the .sts -- always has the names.
+static void _qdTraceInit(void)
+{
+  static thread_local bool done = false;
+  if (done) return;
+  done = true;
+  traceRegisterUserEvent("QD wait for STILL_IDLE", TRACE_QD_IDLEWAIT);
+  traceRegisterUserEvent("QD phase 0 (ask children)", TRACE_QD_PHASE0);
+  traceRegisterUserEvent("QD phase 1 (report counts)", TRACE_QD_PHASE1);
+  traceRegisterUserEvent("QD phase 2 (dirty check)", TRACE_QD_PHASE2);
+  traceRegisterUserEvent("QD round restart (PE 0)", TRACE_QD_ROUND);
+  traceRegisterUserEvent("QD detected (PE 0)", TRACE_QD_DETECTED);
+  traceRegisterUserEvent("QD started (PE 0)", TRACE_QD_START);
+}
+
