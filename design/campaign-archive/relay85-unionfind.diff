  * 
  * @param cb Callback to be invoked after this function has finished
  */
+// relay85 -- ROOT OWNERSHIP OF CROSS-PROCESS COMPONENTS.
+// Each element walks its labelled vertices, dedupes the component labels it
+// holds, and maps each label to its owning chare (the label IS the root's
+// vertexID).  A label whose owner is NOT this chare is evidence that the
+// component STRADDLES: this chare holds vertices of a component rooted
+// elsewhere.  Summing those incidences over all chares gives, per chare c,
+// how much cross-process component structure is rooted at c.
+//   buf[0 .. N-1]  remote incidences of components rooted at chare c
+//   buf[N]         local roots on this chare (parent == -1)
+//   buf[N+1]       distinct labels held locally
+//   buf[N+2]       distinct labels held locally that are rooted elsewhere
+void UnionFindLib::
+root_owner_census(CkCallback cb) {
+    rootCensusCb = cb;
+    const int N = CkNumNodes();
+    std::vector<long> buf(N + 3, 0);
+    std::unordered_set<long> labels;
+    long localRoots = 0;
+    forEachVertex([&](unionFindVertex& v, uint64_t) {
+        if (v.parent == -1) localRoots++;
+        if (v.componentNumber >= 0) labels.insert(v.componentNumber);
+    });
+    for (long lab : labels) {
+        int owner = getLocationFromID((uint64_t)lab).first;
+        if (owner >= 0 && owner < N && owner != thisIndex) {
+            buf[owner]++;
+            buf[N + 2]++;
+        }
+    }
+    buf[N]     = localRoots;
+    buf[N + 1] = (long)labels.size();
+    contribute(sizeof(long) * (N + 3), buf.data(), CkReduction::sum_long,
+               CkCallback(CkReductionTarget(UnionFindLib, root_owner_done), thisProxy[0]));
+}
+
+void UnionFindLib::
+root_owner_done(long *v, int n) {
+    const int N = n - 3;
+    long tot = 0, nz = 0, mx = 0; int mxc = -1;
+    for (int c = 0; c < N; c++) {
+        tot += v[c];
+        if (v[c]) nz++;
+        if (v[c] > mx) { mx = v[c]; mxc = c; }
+    }
+    CkPrintf("[ROOTCENSUS] chares %d   straddle incidences %ld   chares rooting any %ld"
+             "   busiest chare %d with %ld\n", N, tot, nz, mxc, mx);
+    CkPrintf("[ROOTCENSUS] local roots total %ld   distinct labels held %ld"
+             "   labels rooted elsewhere %ld\n", v[N], v[N + 1], v[N + 2]);
+    // full per-chare vector, wrapped
+    char line[512]; int off = 0;
+    for (int c = 0; c < N; c++) {
+        if (off == 0) off = snprintf(line, sizeof(line), "[ROOTCENSUS] c%03d:", c);
+        off += snprintf(line + off, sizeof(line) - off, " %ld", v[c]);
+        if ((c % 16) == 15 || c == N - 1) { CkPrintf("%s\n", line); off = 0; }
+    }
+    // cumulative shape: how much of the mass is in the lowest k chares?
+    long cum = 0; int marks[5] = {N/32, N/8, N/4, N/2, N-1};
+    char cline[256]; int co = snprintf(cline, sizeof(cline), "[ROOTCENSUS] cumulative share:");
+    int mi = 0;
+    for (int c = 0; c < N && mi < 5; c++) {
+        cum += v[c];
+        if (c == marks[mi]) {
+            co += snprintf(cline + co, sizeof(cline) - co, "  first %d chares %.1f%%",
+                           c + 1, tot ? 100.0 * cum / tot : 0.0);
+            mi++;
+        }
+    }
+    CkPrintf("%s\n", cline);
+    if (!rootCensusCb.isInvalid()) rootCensusCb.send();
+}
