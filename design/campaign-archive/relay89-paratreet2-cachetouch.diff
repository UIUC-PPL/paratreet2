+#if FOF_CACHE_TOUCH
+  // relay89 CACHE-TOUCH CENSUS (report-only; -DFOF_CACHE_TOUCH=1, separate
+  // binary). Three states, not one, because a single "touched" fraction
+  // conflates a pruning DEFECT with correct pruning:
+  //   0 = never examined by any certificate
+  //   1 = examined and PRUNED (fetched, looked at, correctly rejected)
+  //   2 = DESCENDED INTO, or its particles were read
+  //
+  // PLAIN NON-ATOMIC BYTE, DELIBERATELY. The cache is a nodegroup shared by
+  // the 7 PEs of a process, so this field is written concurrently. Every
+  // writer only ever RAISES the value (markTouch in Traverser.h) and nothing
+  // clears it during the walk, so the race is benign: a lost update can only
+  // UNDER-report, never corrupt and never over-report. A single byte cannot
+  // tear. Making it atomic would put a lock prefix on the hottest path in the
+  // traversal, which is precisely what the compile-time gate exists to avoid.
+  mutable unsigned char touch_state = 0;
+#endif
+
   Node(int _depth, int _n_children, Node* _parent, Type _type, Key _key, int _tp_index, int _cm_index)
