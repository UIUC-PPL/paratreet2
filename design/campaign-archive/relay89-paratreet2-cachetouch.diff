+// relay89 cache-touch census. Monotone raise only -- see the race note on
+// Node::touch_state. Compiled out entirely unless -DFOF_CACHE_TOUCH=1.
+#if FOF_CACHE_TOUCH
+template <typename N>
+inline void markTouch(const N* n, unsigned char st) {
+  if (n && n->touch_state < st) n->touch_state = st;
+}
+#define FOF_TOUCH(n, st) markTouch((n), (unsigned char)(st))
+#else
+#define FOF_TOUCH(n, st) ((void)0)
+#endif
+
 template <typename Visitor, typename Node, typename StatCollector>
 inline bool doOpen(Visitor& v, Node* source, Node* target, StatCollector* stats) {
   maybeSetKeys(v, source->key, target->key, 0); // no-op unless v opts in
